#Matplot: Make Pretty Pictures
X_val = np.linspace(-1, 1, 10)
Y_val = np.linspace(-1, 1, 10)
X, Y = np.meshgrid(X_val, Y_val)
R = np.sqrt(X**2 + Y**2)
Theta = np.arctan2(Y, X)
R[R == 0] = np.nan 
E_r = 1 / R**2
E_theta = 0

U = E_r * np.cos(Theta) - E_theta * np.sin(Theta)
V = E_r * np.sin(Theta) + E_theta * np.cos(Theta)

plt.quiver(X_val, Y_val, U, V, color = 'purple')
plt.title('Electric Vector Field $E(r)$')
plt.xlabel('X')
plt.ylabel('Y')
plt.grid(True)
plt.show()

